# arr-mcp configuration — copy to `.env` and fill in real API keys.
# Find each API key in the app's UI: Settings > General > Security > API Key.
# Leave a service's two vars blank to disable its tools.

# --- Sonarr (TV) — currently on the .104 box ---
SONARR_URL=http://192.168.68.104:8989
SONARR_API_KEY=REPLACE_ME

# --- Radarr (Movies) — on the .104 box ---
RADARR_URL=http://192.168.68.112:7878
RADARR_API_KEY=REPLACE_ME

# --- Prowlarr (Indexers) — on the .104 box ---
PROWLARR_URL=http://192.168.68.104:9696
PROWLARR_API_KEY=REPLACE_ME

# --- Jellyseerr (Requests) — on the .104 box ---
JELLYSEERR_URL=http://192.168.68.104:5055
JELLYSEERR_API_KEY=REPLACE_ME

# --- Bazarr (Subtitles) — on the .104 box ---
BAZARR_URL=http://192.168.68.112:6767
BAZARR_API_KEY=REPLACE_ME

# --- MCP endpoint auth ---
# REQUIRED before exposing over a tunnel. Generate a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Server bind ---
HOST=0.0.0.0
PORT=8787
